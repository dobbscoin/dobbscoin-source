Name "@PACKAGE_NAME@ (@WINDOWS_BITS@-bit)"

RequestExecutionLevel highest
SetCompressor /SOLID lzma

# General Symbol Definitions
!define REGKEY "SOFTWARE\$(^Name)"
!define VERSION @CLIENT_VERSION_MAJOR@.@CLIENT_VERSION_MINOR@.@CLIENT_VERSION_REVISION@
!define COMPANY "Dobbscoin Core project"
!define URL https://dobbscoin.info

# MUI Symbol Definitions
!define MUI_ICON "@abs_top_srcdir@/share/pixmaps/dobbscoin.ico"
!define MUI_WELCOMEFINISHPAGE_BITMAP "@abs_top_srcdir@/share/pixmaps/nsis-wizard.bmp"
!define MUI_HEADERIMAGE
!define MUI_HEADERIMAGE_RIGHT
!define MUI_HEADERIMAGE_BITMAP "@abs_top_srcdir@/share/pixmaps/nsis-header.bmp"
; The header bitmap is drawn on white, so the header must stay white too.
!define MUI_BGCOLOR FFFFFF
!define MUI_FINISHPAGE_NOAUTOCLOSE
!define MUI_STARTMENUPAGE_REGISTRY_ROOT HKLM
!define MUI_STARTMENUPAGE_REGISTRY_KEY ${REGKEY}
!define MUI_STARTMENUPAGE_REGISTRY_VALUENAME StartMenuGroup
!define MUI_STARTMENUPAGE_DEFAULTFOLDER "@PACKAGE_NAME@"
!define MUI_FINISHPAGE_RUN $INSTDIR\dobbscoin-qt.exe
!define MUI_UNICON "@abs_top_srcdir@/share/pixmaps/dobbscoin.ico"
!define MUI_UNWELCOMEFINISHPAGE_BITMAP "@abs_top_srcdir@/share/pixmaps/nsis-wizard.bmp"
!define MUI_UNFINISHPAGE_NOAUTOCLOSE

# Included files
!include Sections.nsh
!include MUI2.nsh
!if "@WINDOWS_BITS@" == "64"
!include x64.nsh
!include LogicLib.nsh
!endif

# Variables
Var StartMenuGroup

# Installer pages
!insertmacro MUI_PAGE_WELCOME
; The license in plain words. MIT asks for no agreement, so the button is a
; plain Next, not "I Agree".
!define MUI_PAGE_HEADER_TEXT "Required by The Conspiracy"
!define MUI_PAGE_HEADER_SUBTEXT "A little paperwork about the license."
!define MUI_LICENSEPAGE_BUTTON "$(^NextBtn)"
!define MUI_LICENSEPAGE_TEXT_TOP "The fine print, in plain words:"
!define MUI_LICENSEPAGE_TEXT_BOTTOM "Nothing to sign. Click Next to continue."
!insertmacro MUI_PAGE_LICENSE "@abs_top_srcdir@/doc/README_license.txt"
; Leaving the location page checks that the wallet is not running, before
; anything is copied; Abort there keeps the user on the page.
!define MUI_PAGE_CUSTOMFUNCTION_LEAVE CheckNotRunning
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_STARTMENU Application $StartMenuGroup
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

# Installer languages
!insertmacro MUI_LANGUAGE English

# Installer attributes
OutFile @abs_top_builddir@/dobbscoin-${VERSION}-win@WINDOWS_BITS@-setup.exe
!if "@WINDOWS_BITS@" == "64"
InstallDir $PROGRAMFILES64\Dobbscoin
!else
InstallDir $PROGRAMFILES\Dobbscoin
!endif
CRCCheck on
XPStyle on
BrandingText " "
ShowInstDetails show
VIProductVersion ${VERSION}.@CLIENT_VERSION_BUILD@
VIAddVersionKey ProductName "Dobbscoin Core"
VIAddVersionKey ProductVersion "${VERSION}"
VIAddVersionKey CompanyName "${COMPANY}"
VIAddVersionKey CompanyWebsite "${URL}"
VIAddVersionKey FileVersion "${VERSION}"
VIAddVersionKey FileDescription ""
VIAddVersionKey LegalCopyright "2009-@COPYRIGHT_YEAR@ The Bitcoin Core developers, 2013-@COPYRIGHT_YEAR@ The Dobbscoin developers"
InstallDirRegKey HKCU "${REGKEY}" Path
ShowUninstDetails show

# A running wallet cannot be overwritten or deleted: Windows refuses write
# access to a running .exe, and NSIS then stops halfway with "Error opening
# file for writing". Opening each program for append fails the same way, so
# test that first and say what to do. Silent installs (/S) answer Cancel.
!macro CHECK_NOT_RUNNING UN
Function ${UN}CheckNotRunning
    retry:
    StrCpy $R1 ""
    ${If} ${FileExists} "$INSTDIR\dobbscoin-qt.exe"
        ClearErrors
        FileOpen $R0 "$INSTDIR\dobbscoin-qt.exe" a
        ${If} ${Errors}
            StrCpy $R1 "dobbscoin-qt.exe"
        ${Else}
            FileClose $R0
        ${EndIf}
    ${EndIf}
    ${If} $R1 == ""
    ${AndIf} ${FileExists} "$INSTDIR\daemon\dobbscoind.exe"
        ClearErrors
        FileOpen $R0 "$INSTDIR\daemon\dobbscoind.exe" a
        ${If} ${Errors}
            StrCpy $R1 "dobbscoind.exe"
        ${Else}
            FileClose $R0
        ${EndIf}
    ${EndIf}
    ${If} $R1 != ""
        MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "Dobbscoin is still running ($R1).$\r$\n$\r$\nClose the wallet with File > Exit, check Task Manager for dobbscoin-qt.exe and dobbscoind.exe, then click Retry." /SD IDCANCEL IDRETRY retry
        Abort
    ${EndIf}
FunctionEnd
!macroend
!insertmacro CHECK_NOT_RUNNING ""
!insertmacro CHECK_NOT_RUNNING "un."

# Installer sections
Section -Main SEC0000
    Call CheckNotRunning ; again, for /S installs that skip the pages
    SetOutPath $INSTDIR
    SetOverwrite on
    File @abs_top_builddir@/release/dobbscoin-qt.exe
    File /oname=COPYING.txt @abs_top_srcdir@/COPYING
    File /oname=readme.txt @abs_top_srcdir@/doc/README_windows.txt
    File /oname=license-summary.txt @abs_top_srcdir@/doc/README_license.txt
    SetOutPath $INSTDIR\daemon
    File @abs_top_builddir@/release/dobbscoind.exe
    File @abs_top_builddir@/release/dobbscoin-cli.exe
    ; Only what a wallet user might open. The whole doc/ folder used to ship,
    ; developer build guides, gitian screenshots and release notes back to 0.3
    ; included. The uninstaller still removes all of $INSTDIR\doc, so an older
    ; install's copy goes on upgrade-then-uninstall.
    SetOutPath $INSTDIR\doc
    File @abs_top_srcdir@/doc/files.md
    File @abs_top_srcdir@/doc/tor.md
    SetOutPath $INSTDIR
    WriteRegStr HKCU "${REGKEY}\Components" Main 1

    # Remove old wxwidgets-based-dobbscoin executable and locales:
    Delete /REBOOTOK $INSTDIR\dobbscoin.exe
    RMDir /r /REBOOTOK $INSTDIR\locale
SectionEnd

Section -post SEC0001
    WriteRegStr HKCU "${REGKEY}" Path $INSTDIR
    SetOutPath $INSTDIR
    WriteUninstaller $INSTDIR\uninstall.exe
    !insertmacro MUI_STARTMENU_WRITE_BEGIN Application
    CreateDirectory $SMPROGRAMS\$StartMenuGroup
    CreateShortcut "$SMPROGRAMS\$StartMenuGroup\$(^Name).lnk" $INSTDIR\dobbscoin-qt.exe
    CreateShortcut "$SMPROGRAMS\$StartMenuGroup\Uninstall $(^Name).lnk" $INSTDIR\uninstall.exe
    !insertmacro MUI_STARTMENU_WRITE_END
    WriteRegStr HKCU "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\$(^Name)" DisplayName "$(^Name)"
    WriteRegStr HKCU "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\$(^Name)" DisplayVersion "${VERSION}"
    WriteRegStr HKCU "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\$(^Name)" Publisher "${COMPANY}"
    WriteRegStr HKCU "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\$(^Name)" URLInfoAbout "${URL}"
    WriteRegStr HKCU "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\$(^Name)" DisplayIcon $INSTDIR\uninstall.exe
    WriteRegStr HKCU "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\$(^Name)" UninstallString $INSTDIR\uninstall.exe
    WriteRegDWORD HKCU "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\$(^Name)" NoModify 1
    WriteRegDWORD HKCU "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\$(^Name)" NoRepair 1
    WriteRegStr HKCR "dobbscoin" "URL Protocol" ""
    WriteRegStr HKCR "dobbscoin" "" "URL:Dobbscoin"
    WriteRegStr HKCR "dobbscoin\DefaultIcon" "" $INSTDIR\dobbscoin-qt.exe
    WriteRegStr HKCR "dobbscoin\shell\open\command" "" '"$INSTDIR\dobbscoin-qt.exe" "%1"'
SectionEnd

# Macro for selecting uninstaller sections
!macro SELECT_UNSECTION SECTION_NAME UNSECTION_ID
    Push $R0
    ReadRegStr $R0 HKCU "${REGKEY}\Components" "${SECTION_NAME}"
    StrCmp $R0 1 0 next${UNSECTION_ID}
    !insertmacro SelectSection "${UNSECTION_ID}"
    GoTo done${UNSECTION_ID}
next${UNSECTION_ID}:
    !insertmacro UnselectSection "${UNSECTION_ID}"
done${UNSECTION_ID}:
    Pop $R0
!macroend

# Uninstaller sections
Section /o -un.Main UNSEC0000
    Call un.CheckNotRunning
    Delete /REBOOTOK $INSTDIR\dobbscoin-qt.exe
    Delete /REBOOTOK $INSTDIR\COPYING.txt
    Delete /REBOOTOK $INSTDIR\readme.txt
    Delete /REBOOTOK $INSTDIR\license-summary.txt
    RMDir /r /REBOOTOK $INSTDIR\daemon
    RMDir /r /REBOOTOK $INSTDIR\doc
    DeleteRegValue HKCU "${REGKEY}\Components" Main
SectionEnd

Section -un.post UNSEC0001
    DeleteRegKey HKCU "SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\$(^Name)"
    Delete /REBOOTOK "$SMPROGRAMS\$StartMenuGroup\Uninstall $(^Name).lnk"
    Delete /REBOOTOK "$SMPROGRAMS\$StartMenuGroup\$(^Name).lnk"
    Delete /REBOOTOK "$SMSTARTUP\Dobbscoin.lnk"
    Delete /REBOOTOK $INSTDIR\uninstall.exe
    Delete /REBOOTOK $INSTDIR\debug.log
    Delete /REBOOTOK $INSTDIR\db.log
    DeleteRegValue HKCU "${REGKEY}" StartMenuGroup
    # The Start-menu page stores its folder under MUI_STARTMENUPAGE_REGISTRY_ROOT (HKLM),
    # not HKCU, so clear it there too or it outlives the uninstall.
    DeleteRegValue HKLM "${REGKEY}" StartMenuGroup
    DeleteRegKey /IfEmpty HKLM "${REGKEY}"
    DeleteRegValue HKCU "${REGKEY}" Path
    DeleteRegKey /IfEmpty HKCU "${REGKEY}\Components"
    DeleteRegKey /IfEmpty HKCU "${REGKEY}"
    DeleteRegKey HKCR "dobbscoin"
    RmDir /REBOOTOK $SMPROGRAMS\$StartMenuGroup
    RmDir /REBOOTOK $INSTDIR
    Push $R0
    StrCpy $R0 $StartMenuGroup 1
    StrCmp $R0 ">" no_smgroup
no_smgroup:
    Pop $R0
SectionEnd

# Installer functions
Function .onInit
    InitPluginsDir
!if "@WINDOWS_BITS@" == "64"
    ${If} ${RunningX64}
      ; disable registry redirection (enable access to 64-bit portion of registry)
      SetRegView 64
    ${Else}
      MessageBox MB_OK|MB_ICONSTOP "Cannot install 64-bit version on a 32-bit system."
      Abort
    ${EndIf}
!endif
FunctionEnd

# Uninstaller functions
Function un.onInit
!if "@WINDOWS_BITS@" == "64"
    ; .onInit switched the installer to the 64-bit registry view; without the same
    ; here the uninstaller reads and deletes in the 32-bit view and misses HKLM keys.
    SetRegView 64
!endif
    ReadRegStr $INSTDIR HKCU "${REGKEY}" Path
    !insertmacro MUI_STARTMENU_GETFOLDER Application $StartMenuGroup
    !insertmacro SELECT_UNSECTION Main ${UNSEC0000}
FunctionEnd
