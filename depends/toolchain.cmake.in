# Generated by depends/Makefile from depends/toolchain.cmake.in. Do not edit.
#
# Builds Dobbscoin Core with CMake against this depends prefix:
#
#   cmake -B build --toolchain depends/@host@/toolchain.cmake
#
# It is the CMake counterpart of share/config.site, which does the same job for
# configure: the compilers and flags depends built with, where to find the
# packages, and which features the packages that were built allow.
# Modelled on Bitcoin Core v29's depends/toolchain.cmake.in.

if(@depends_crosscompiling@)
  set(CMAKE_SYSTEM_NAME @host_system_name@)
  set(CMAKE_SYSTEM_PROCESSOR @host_arch@)
endif()

set(CMAKE_C_COMPILER @CC@)
set(CMAKE_CXX_COMPILER @CXX@)
set(CMAKE_AR @AR@)
set(CMAKE_RANLIB @RANLIB@)
set(CMAKE_NM @NM@)
set(CMAKE_STRIP @STRIP@)

# config.site's CFLAGS/CXXFLAGS/CPPFLAGS/LDFLAGS (e.g. "-pipe -O2"). configure
# adds no -g -O2 of its own when they are set, and neither does CMakeLists.txt
# when DEPENDS_PREFIX is.
set(CMAKE_C_FLAGS_INIT "@CFLAGS@ @CPPFLAGS@")
set(CMAKE_CXX_FLAGS_INIT "@CXXFLAGS@ @CPPFLAGS@")
set(CMAKE_EXE_LINKER_FLAGS_INIT "@LDFLAGS@")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "@LDFLAGS@")
set(DEPENDS_PREFIX "${CMAKE_CURRENT_LIST_DIR}")
# config.site also puts -I$prefix/include in CPPFLAGS, so every compile sees
# the depends headers (crypto/scrypt.cpp includes <openssl/sha.h> directly).
set(CMAKE_C_STANDARD_INCLUDE_DIRECTORIES "${DEPENDS_PREFIX}/include")
set(CMAKE_CXX_STANDARD_INCLUDE_DIRECTORIES "${DEPENDS_PREFIX}/include")

# Find packages in this prefix only, and never the build machine's libraries.
# Programs (moc, protoc, lrelease) run on the build machine: they are in native/.
set(CMAKE_FIND_USE_CMAKE_ENVIRONMENT_PATH OFF)
set(CMAKE_FIND_ROOT_PATH "${DEPENDS_PREFIX}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_PROGRAM_PATH "${DEPENDS_PREFIX}/native/bin")
set(ENV{PKG_CONFIG_LIBDIR} "${DEPENDS_PREFIX}/lib/pkgconfig")
set(ENV{PKG_CONFIG_PATH} "${DEPENDS_PREFIX}/share/pkgconfig")
set(PKG_CONFIG_ARGN --static)
# Every depends library is static; this makes FindOpenSSL add what a static
# libcrypto needs after it on Windows (ws2_32, crypt32).
set(OPENSSL_USE_STATIC_LIBS ON)

# Options follow the packages that were built, as config.site does for
# NO_QT, NO_WALLET and NO_UPNP. A -D on the command line still wins.
if("@no_qt@" STREQUAL "")
  set(BUILD_GUI ON CACHE BOOL "")
else()
  set(BUILD_GUI OFF CACHE BOOL "")
endif()
if("@no_wallet@" STREQUAL "")
  set(ENABLE_WALLET ON CACHE BOOL "")
else()
  set(ENABLE_WALLET OFF CACHE BOOL "")
endif()
if("@no_upnp@" STREQUAL "")
  set(WITH_MINIUPNPC ON CACHE BOOL "")
  set(WITH_NATPMP ON CACHE BOOL "")
else()
  set(WITH_MINIUPNPC OFF CACHE BOOL "")
  set(WITH_NATPMP OFF CACHE BOOL "")
endif()
if(NOT "@debug@" STREQUAL "")
  set(REDUCE_EXPORTS OFF CACHE BOOL "")
endif()
